+++ b/vendor/seccomp-src/apply-seccomp.c
@@ -57,5 +57,6 @@
 #include <linux/bpf_common.h>

 #include "unix-block-bpf.h"
+#include "unix-allow-bpf.h"

 #ifndef PR_SET_NO_NEW_PRIVS
