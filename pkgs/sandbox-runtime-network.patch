+/** Resolve anew for each connection; reject the entire mixed answer set. */
+export async function resolvePublicAddress(host: string): Promise<string> {
+  if (!isValidHost(host)) throw new Error('Invalid public-egress host')
+  const canonical = canonicalizeHost(host)
+  if (!canonical) throw new Error('Invalid public-egress host')
+  // Node skips lookup callbacks for literals, so check them explicitly too.
+  const addresses = isIP(canonical)
+    ? [{ address: canonical }]
