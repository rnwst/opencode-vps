diff --git a/searchfox-lib/src/client.rs b/searchfox-lib/src/client.rs
--- a/searchfox-lib/src/client.rs
+++ b/searchfox-lib/src/client.rs
@@ -1,5 +1,5 @@
 use crate::types::{RequestLog, ResponseLog};
-use anyhow::Result;
+use anyhow::{Context, Result};
 use log::debug;
 use reqwest::{Client, Url};
 use std::time::{Duration, Instant};
@@ -69,7 +69,22 @@ impl SearchfoxClient {
     }
 
     fn create_tls13_client() -> Result<Client> {
-        Client::builder()
+        let mut builder = Client::builder();
+        // Rustls' bundled WebPKI roots do not include the outbound proxy CA.
+        // Keep those roots and additionally trust the runtime's PEM bundle.
+        if let Some(path) = std::env::var_os("SSL_CERT_FILE").filter(|p| !p.is_empty()) {
+            let pem = std::fs::read(&path)
+                .with_context(|| format!("Failed to read SSL_CERT_FILE: {:?}", path))?;
+            let certificates = reqwest::Certificate::from_pem_bundle(&pem)
+                .context("Failed to parse SSL_CERT_FILE certificates")?;
+            if certificates.is_empty() {
+                anyhow::bail!("SSL_CERT_FILE contains no certificates");
+            }
+            for certificate in certificates {
+                builder = builder.add_root_certificate(certificate);
+            }
+        }
+        builder
             .user_agent(Self::get_user_agent())
             .use_rustls_tls()
             .min_tls_version(reqwest::tls::Version::TLS_1_2)
